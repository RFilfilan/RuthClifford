---
import PortfolioEntries from './PortfolioEntries.astro';

const { intro, items, placeholder } = Astro.props;
---

<section class="content-section page-shell section-with-tint" id="publications" aria-labelledby="publications-title">
	<div class="section-label">
		<span class="section-number">02</span>
		<h2 id="publications-title">Publications</h2>
	</div>
	<div class="section-content">
		<p class="section-intro">{intro}</p>
		<PortfolioEntries items={items} placeholder={placeholder} />
	</div>
</section>
