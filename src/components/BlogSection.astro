---
import PortfolioEntries from './PortfolioEntries.astro';

const { intro, items, placeholder } = Astro.props;
---

<section class="content-section page-shell" id="blog" aria-labelledby="blog-title">
	<div class="section-label">
		<span class="section-number">03</span>
		<h2 id="blog-title">Blog</h2>
	</div>
	<div class="section-content">
		<p class="section-intro">{intro}</p>
		<PortfolioEntries items={items} placeholder={placeholder} />
	</div>
</section>
