---
const { name } = Astro.props;
---

<section class="hero page-shell" aria-labelledby="hero-title">
	<p class="eyebrow">Research <span aria-hidden="true">/</span> writing <span aria-hidden="true">/</span> creative practice</p>
	<h1 id="hero-title">
		{name}<br />
		<span>Thinking otherwise about fashion.</span>
	</h1>
	<div class="hero-bottom">
		<p class="hero-intro">
			Exploring sustainable fashion, textile crafts, degrowth, and decolonial approaches to fashion—with attention
			to Indian artisans and craft communities.
		</p>
		<a class="text-link" href="#projects">
			Explore selected projects <span aria-hidden="true">↓</span>
		</a>
	</div>
	<div class="hero-rule" aria-hidden="true"></div>
</section>
